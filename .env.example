# Copy to .env and fill in every value marked required.
#
# docker compose refuses to start when a required variable is missing or empty.
# That is deliberate: the previous revision fell back to defaults that were the
# same credentials committed to the repository, so a forgotten .env produced a
# running stack anyone on the network could reach. Failing closed is better
# than listening with a published password.
#
# `docker compose config --variables` lists every variable compose reads and
# whether it is required.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Port the backend binds. Validated at boot: must be an integer in 1-65535.
PORT=4000

# ---------------------------------------------------------------------------
# WhatsApp Cloud API
# ---------------------------------------------------------------------------

# Signs the X-Hub-Signature-256 header on every inbound notification.
# Required. Without it the process refuses to boot rather than rejecting every
# webhook with a 401 that reads as a Meta outage.
WHATSAPP_APP_SECRET=

# Answers the GET subscription handshake. Required, for the same reason.
WHATSAPP_VERIFY_TOKEN=

# Planned: consumed by the Cloud API dispatch that is not written yet.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
#
# Applied to the hosted project through supabase/migrations. The compose db is
# a bare postgres:16-alpine with no auth schema, so the RLS policies are not
# exercised locally.

# Optional for now: nothing on the compose branch reads them. Promote both to
# required (compose `${VAR:?}`) when the Supabase-backed code lands.
SUPABASE_URL=
# Bypasses RLS. Treat it as a production credential even in development.
SUPABASE_SERVICE_ROLE_KEY=
# Only the commented-out frontend block consumes this.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Database (compose `db` service)
# ---------------------------------------------------------------------------
#
# Defaults are the postgres image's own, so only the password is required.

POSTGRES_DB=postgres
POSTGRES_USER=postgres
# Required. Was literally "postgres" in the previous revision.
POSTGRES_PASSWORD=
# scram-sha-256 rather than md5 or trust.
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# ---------------------------------------------------------------------------
# OpenObserve
# ---------------------------------------------------------------------------

# Required. Root account for the OpenObserve web UI and API.
ZO_ROOT_USER_EMAIL=
# Required. Was a literal in the previous revision.
ZO_ROOT_USER_PASSWORD=

# Required. Base64 of "email:password" or of an ingestion token, which is what
# the collector sends to push traces. Format: Basic <base64>.
#
# Generate with: printf '%s' "$ZO_ROOT_USER_EMAIL:$ZO_ROOT_USER_PASSWORD" | base64
OPENOBSERVE_AUTH_HEADER=

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------

# OTLP/HTTP traces. The backend exports here; the collector fans out to
# OpenObserve. Inside compose this resolves to the collector service name, so
# this value is for running the backend on the host instead.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
