# ==============================================================================
# Full-Stack AI Stack Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
BACKEND_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# AI Provider Credentials (Vercel AI SDK / OpenRouter)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# ------------------------------------------------------------------------------
# Supabase & PostgreSQL Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:your_secure_db_password_here@db:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# Security, OAuth & Token Delegation (RFC 8693)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_rs256_or_hs256_key
DELEGATION_TOKEN_SECRET=your_downscoped_delegation_token_signing_secret
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret

# ------------------------------------------------------------------------------
# Observability: OpenObserve & OpenTelemetry
# ------------------------------------------------------------------------------
OPENOBSERVE_ROOT_USER_EMAIL=admin@example.com
OPENOBSERVE_ROOT_USER_PASSWORD=ComplexPassword123!
OPENOBSERVE_ENDPOINT=http://openobserve:5080/api/default
# Base64 encoded 'OPENOBSERVE_ROOT_USER_EMAIL:OPENOBSERVE_ROOT_USER_PASSWORD'
OPENOBSERVE_TOKEN=QmFzaWMgWVdSZmFXNUFZV3R2YkM1amIyMDZRMjl0Y0d4bGVERXpPVEU9

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME_FRONTEND=nextjs-frontend
OTEL_SERVICE_NAME_BACKEND=bun-agent-backend

# ------------------------------------------------------------------------------
# Error Tracking & Analytics
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
