# Port the backend binds. Validated at boot: must be an integer in 1-65535.
PORT=4000

# WhatsApp Cloud API. WHATSAPP_APP_SECRET signs X-Hub-Signature-256 and
# WHATSAPP_VERIFY_TOKEN answers the GET subscription handshake. Both are
# required; the process refuses to start without them.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Supabase. Applied to the hosted project through supabase/migrations; the
# compose db is a bare postgres:16-alpine with no auth schema, so the RLS
# policies are not exercised locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OTLP/HTTP traces. The backend exports here; the collector fans out to
# OpenObserve.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
